{
    "name": "omines/antispam-bundle",
    "type": "symfony-bundle",
    "description": "The Swiss Army Knife for protecting your Symfony forms from all kinds of spam",
    "keywords": ["symfony","spam","antispam","honeypot","spam timer","cyrillic"],
    "license": "MIT",
    "authors": [
        {
            "name": "Niels Keurentjes",
            "email": "niels.keurentjes@omines.com",
            "homepage": "https://www.omines.nl/"
        }
    ],
    "support": {
      "issues": "https://github.com/omines/antispam-bundle/issues"
    },
    "require": {
        "php": ">=8.3",
        "ext-mbstring": "*",
        "psr/log": "^2.0|^3.0",
        "symfony/clock": "^6.4.48|^7.4.21|^8.1",
        "symfony/form": "^6.4.21|^7.4.23|^8.1",
        "symfony/framework-bundle": "^6.4.49|^7.4.23|^8.1",
        "symfony/translation": "^6.4.50|^7.4.23|^8.1",
        "symfony/twig-bridge": "^6.4.25|^7.4.22|^8.1",
        "symfony/validator": "^6.4.50|^7.4.23|^8.1",
        "symfony/yaml": "^6.4.50|^7.4.23|^8.1"
    },
    "require-dev": {
        "ekino/phpstan-banned-code": "^3.2.0",
        "friendsofphp/php-cs-fixer": "^3.95.32",
        "infection/infection": "^0.35.12",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan": "^2.3.7",
        "phpstan/phpstan-phpunit": "^2.1.2",
        "phpstan/phpstan-symfony": "^2.1.1",
        "phpunit/phpunit": "^12.5.4|^13.4.8",
        "symfony/browser-kit": "^6.4|^7.4.23|^8.1.11",
        "symfony/css-selector": "^6.4|^7.4.22|^8.1.10",
        "symfony/debug-bundle": "^6.4|^7.4.8|^8.1.0",
        "symfony/dotenv": "^6.4|^7.4.18|^8.1.6",
        "symfony/lock": "^6.4|^7.4|^8.1",
        "symfony/monolog-bundle": "^3.11.1|^4.1.0",
        "symfony/rate-limiter": "^6.4|^7.4|^8.1",
        "symfony/routing": "^6.4.50|^7.4.23|^8.1.11",
        "symfony/runtime": "^6.4.40|^7.4.23|^8.1.11",
        "symfony/twig-bundle": "^6.4|^7.4.21|^8.1.9",
        "symfony/web-profiler-bundle": "^6.4|^7.4.23|^8.1.11"
    },
    "suggest": {
        "symfony/rate-limiter": "To limit how often a profile's forms can be submitted"
    },
    "conflict": {
        "monolog/monolog": "<3"
    },
    "autoload": {
        "psr-4": { "Omines\\AntiSpamBundle\\": "src/"}
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Tests\\Fixture\\": "tests/Fixture/src/"
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "audit": {"abandoned": "fail"},
        "allow-plugins": {
            "infection/extension-installer": true,
            "phpstan/extension-installer": true,
            "symfony/flex": true,
            "symfony/runtime": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "0.1-dev"
        }
    }
}
